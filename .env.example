# Clients publics desktop (Authorization Code + PKCE / Device Flow)
SYN_GOOGLE_CLIENT_ID=
SYN_MICROSOFT_CLIENT_ID=
SYN_GITHUB_CLIENT_ID=

# Slack exige un callback HTTPS. En développement, configure un tunnel HTTPS
# vers 127.0.0.1:8787 et utilise son URL comme redirect URI dans Slack.
SYN_SLACK_CLIENT_ID=
SYN_SLACK_CLIENT_SECRET=
SYN_SLACK_REDIRECT_URI=https://votre-tunnel.example/oauth/callback
SYN_SLACK_CALLBACK_PORT=8787
